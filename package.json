{
  "name": "sims-smk",
  "private": true,
  "version": "0.1.0",
  "description": "Sistem Informasi Manajemen Sekolah SMK",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @sims/api",
    "dev:web": "npm run dev -w @sims/web",
    "build": "npm run typecheck --workspaces --if-present && npm run build -w @sims/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @sims/api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @sims/api",
    "db:migrate": "npm run db:migrate -w @sims/api",
    "db:seed": "npm run db:seed -w @sims/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
